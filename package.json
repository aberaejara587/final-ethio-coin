  "html": "<!DOCTYPE html>\n<html lang=\"om\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>Ethio Coin · PRO</title>\n    <script src=\"https://sad.adsgram.ai/js/sad.min.js\"></script>\n    <script src=\"https://telegram.org/js/telegram-web-app.js\"></script>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Syne:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n    \n    <style>\n        :root {\n            --bg-void: #05080d;\n            --bg-surface: #0a0f18;\n            --bg-elevated: #111927;\n            --glass-bg: rgba(14, 22, 35, 0.65);\n            --glass-border: rgba(255, 255, 255, 0.06);\n            --text-primary: #f1f5f9;\n            --text-secondary: #94a3b8;\n            --text-muted: #64748b;\n            --accent-gold: #e5b12e;\n            --accent-teal: #22d3ee;\n            --accent-rose: #fb7185;\n            --accent-emerald: #34d399;\n            --accent-violet: #a78bfa;\n            --glow-gold: rgba(229, 177, 46, 0.25);\n            --glow-teal: rgba(34, 211, 238, 0.2);\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            font-size: 16px;\n        }\n\n        body {\n            font-family: 'Space Grotesk', sans-serif;\n            background: var(--bg-void);\n            color: var(--text-primary);\n            overflow-x: hidden;\n            min-height: 100vh;\n            position: relative;\n        }\n\n        /* Dynamic background layers */\n        .bg-layer {\n            position: fixed;\n            inset: 0;\n            pointer-events: none;\n            z-index: 0;\n        }\n\n        .bg-gradient-layer {\n            background: \n                radial-gradient(ellipse 80% 60% at 10% 20%, rgba(34, 211, 238, 0.08) 0%, transparent 50%),\n                radial-gradient(ellipse 60% 50% at 90% 80%, rgba(229, 177, 46, 0.06) 0%, transparent 50%),\n                radial-gradient(ellipse 100% 100% at 50% 0%, rgba(10, 15, 24, 1) 0%, var(--bg-void) 100%);\n        }\n\n        .bg-noise-layer {\n            opacity: 0.03;\n            background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E\");\n        }\n\n        .bg-grid-layer {\n            background-image: \n                linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),\n                linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);\n            background-size: 60px 60px;\n            mask-image: radial-gradient(ellipse 80% 50% at 50% 0%, black 0%, transparent 70%);\n        }\n\n        /* Particle container */\n        #particles-canvas {\n            position: fixed;\n            inset: 0;\n            z-index: 1;\n            pointer-events: none;\n        }\n\n        /* Scrollbar */\n        .no-scrollbar::-webkit-scrollbar { display: none; }\n        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n        /* Typography */\n        .font-display {\n            font-family: 'Syne', sans-serif;\n        }\n\n        /* Premium glass card */\n        .glass-premium {\n            background: var(--glass-bg);\n            backdrop-filter: blur(24px) saturate(1.4);\n            -webkit-backdrop-filter: blur(24px) saturate(1.4);\n            border: 1px solid var(--glass-border);\n            border-radius: 1.5rem;\n            box-shadow: \n                0 4px 24px -8px rgba(0, 0, 0, 0.5),\n                inset 0 1px 0 rgba(255, 255, 255, 0.04);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .glass-premium::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            border-radius: inherit;\n            padding: 1px;\n            background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, transparent 50%, rgba(255,255,255,0.02) 100%);\n            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n            mask-composite: exclude;\n            -webkit-mask-composite: xor;\n            pointer-events: none;\n        }\n\n        /* Navigation glass */\n        .nav-glass {\n            background: rgba(8, 12, 20, 0.85);\n            backdrop-filter: blur(32px) saturate(1.6);\n            -webkit-backdrop-filter: blur(32px) saturate(1.6);\n            border-top: 1px solid rgba(255, 255, 255, 0.05);\n        }\n\n        .top-bar-glass {\n            background: rgba(8, 12, 20, 0.75);\n            backdrop-filter: blur(24px);\n            -webkit-backdrop-filter: blur(24px);\n            border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n        }\n\n        /* Page system */\n        .page {\n            display: none;\n            min-height: 100vh;\n            padding-bottom: 140px;\n            position: relative;\n            z-index: 10;\n        }\n\n        .page.active {\n            display: block;\n            animation: pageReveal 0.5s cubic-bezier(0.16, 1, 0.3, 1);\n        }\n\n        @keyframes pageReveal {\n            from {\n                opacity: 0;\n                transform: translateY(16px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* Stagger children animation */\n        .stagger-child {\n            opacity: 0;\n            transform: translateY(20px);\n        }\n\n        .page.active .stagger-child {\n            animation: staggerIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n        }\n\n        .page.active .stagger-child:nth-child(1) { animation-delay: 0.05s; }\n        .page.active .stagger-child:nth-child(2) { animation-delay: 0.1s; }\n        .page.active .stagger-child:nth-child(3) { animation-delay: 0.15s; }\n        .page.active .stagger-child:nth-child(4) { animation-delay: 0.2s; }\n        .page.active .stagger-child:nth-child(5) { animation-delay: 0.25s; }\n\n        @keyframes staggerIn {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* Buttons */\n        .btn-primary {\n            background: linear-gradient(135deg, var(--accent-gold) 0%, #d4a41a 100%);\n            color: #0a0f18;\n            font-weight: 700;\n            font-family: 'Syne', sans-serif;\n            border: none;\n            border-radius: 1rem;\n            padding: 1.25rem 2rem;\n            cursor: pointer;\n            position: relative;\n            overflow: hidden;\n            transition: transform 0.2s ease, box-shadow 0.2s ease;\n            box-shadow: 0 8px 32px -8px rgba(229, 177, 46, 0.4);\n        }\n\n        .btn-primary::after {\n            content: '';\n            position: absolute;\n            inset: 0;\n            background: linear-gradient(135deg, transparent 0%, rgba(255,255,255,0.2) 50%, transparent 100%);\n            transform: translateX(-100%);\n            transition: transform 0.4s ease;\n        }\n\n        .btn-primary:hover::after {\n            transform: translateX(100%);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 12px 40px -8px rgba(229, 177, 46, 0.5);\n        }\n\n        .btn-primary:active {\n            transform: translateY(0) scale(0.98);\n        }\n\n        .btn-secondary {\n            background: rgba(255, 255, 255, 0.04);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            color: var(--text-primary);\n            font-weight: 600;\n            border-radius: 1rem;\n            padding: 1rem 1.5rem;\n            cursor: pointer;\n            transition: all 0.2s ease;\n            backdrop-filter: blur(8px);\n        }\n\n        .btn-secondary:hover {\n            background: rgba(255, 255, 255, 0.08);\n            border-color: rgba(255, 255, 255, 0.15);\n            transform: translateY(-1px);\n        }\n\n        .btn-secondary:active {\n            transform: scale(0.98);\n        }\n\n        .btn-share {\n            background: linear-gradient(135deg, #0891b2 0%, #0e7490 100%);\n            color: white;\n            font-weight: 700;\n            font-family: 'Syne', sans-serif;\n            border: none;\n            border-radius: 1rem;\n            padding: 1.25rem 2rem;\n            cursor: pointer;\n            transition: all 0.2s ease;\n            box-shadow: 0 8px 24px -8px rgba(8, 145, 178, 0.4);\n        }\n\n        .btn-share:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 12px 32px -8px rgba(8, 145, 178, 0.5);\n        }\n\n        /* Accent indicators */\n        .accent-line {\n            width: 4px;\n            height: 100%;\n            position: absolute;\n            left: 0;\n            top: 0;\n            border-radius: 0 4px 4px 0;\n        }\n\n        .accent-gold { background: linear-gradient(180deg, var(--accent-gold) 0%, rgba(229, 177, 46, 0.3) 100%); }\n        .accent-teal { background: linear-gradient(180deg, var(--accent-teal) 0%, rgba(34, 211, 238, 0.3) 100%); }\n        .accent-emerald { background: linear-gradient(180deg, var(--accent-emerald) 0%, rgba(52, 211, 153, 0.3) 100%); }\n        .accent-rose { background: linear-gradient(180deg, var(--accent-rose) 0%, rgba(251, 113, 133, 0.3) 100%); }\n\n        /* Navigation items */\n        .nav-item {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            gap: 0.375rem;\n            padding: 0.75rem 1rem;\n            border-radius: 1rem;\n            cursor: pointer;\n            transition: all 0.25s ease;\n            color: var(--text-muted);\n            background: transparent;\n            border: none;\n            font-family: inherit;\n        }\n\n        .nav-item:hover {\n            color: var(--text-secondary);\n        }\n\n        .nav-item.active {\n            color: var(--accent-gold);\n            background: rgba(229, 177, 46, 0.08);\n        }\n\n        .nav-item.active .nav-icon {\n            transform: translateY(-2px);\n        }\n\n        .nav-icon {\n            width: 24px;\n            height: 24px;\n            transition: transform 0.25s ease;\n        }\n\n        .nav-label {\n            font-size: 0.65rem;\n            font-weight: 700;\n            letter-spacing: 0.08em;\n            text-transform: uppercase;\n        }\n\n        /* Stat cards */\n        .stat-card {\n            background: rgba(255, 255, 255, 0.02);\n            border: 1px solid rgba(255, 255, 255, 0.05);\n            border-radius: 1rem;\n            padding: 1.25rem;\n            transition: all 0.25s ease;\n        }\n\n        .stat-card:hover {\n            background: rgba(255, 255, 255, 0.04);\n            border-color: rgba(255, 255, 255, 0.08);\n        }\n\n        .stat-label {\n            font-size: 0.65rem;\n            font-weight: 600;\n            letter-spacing: 0.1em;\n            text-transform: uppercase;\n            color: var(--text-muted);\n            margin-bottom: 0.5rem;\n        }\n\n        .stat-value {\n            font-family: 'Syne', sans-serif;\n            font-size: 1.75rem;\n            font-weight: 800;\n            line-height: 1;\n        }\n\n        /* Progress ring */\n        .progress-ring {\n            position: relative;\n            width: 56px;\n            height: 56px;\n        }\n\n        .progress-ring svg {\n            transform: rotate(-90deg);\n        }\n\n        .progress-ring-bg {\n            stroke: rgba(255, 255, 255, 0.08);\n        }\n\n        .progress-ring-fill {\n            stroke: var(--accent-teal);\n            stroke-linecap: round;\n            transition: stroke-dashoffset 0.5s ease;\n        }\n\n        .progress-ring-text {\n            position: absolute;\n            inset: 0;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 0.7rem;\n            font-weight: 700;\n            color: var(--text-secondary);\n        }\n\n        /* Input styles */\n        .input-premium {\n            width: 100%;\n            background: rgba(0, 0, 0, 0.3);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            border-radius: 1rem;\n            padding: 1.125rem 1.25rem;\n            font-size: 0.9rem;\n            font-family: inherit;\n            color: var(--text-primary);\n            transition: all 0.2s ease;\n        }\n\n        .input-premium::placeholder {\n            color: var(--text-muted);\n        }\n\n        .input-premium:focus {\n            outline: none;\n            border-color: var(--accent-teal);\n            box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.1);\n        }\n\n        /* Locked button */\n        .btn-locked {\n            background: rgba(255, 255, 255, 0.03);\n            color: var(--text-muted);\n            font-weight: 700;\n            font-family: 'Syne', sans-serif;\n            border: 1px dashed rgba(255, 255, 255, 0.1);\n            border-radius: 1rem;\n            padding: 1.25rem 2rem;\n            cursor: not-allowed;\n            opacity: 0.7;\n        }\n\n        /* Animations */\n        @keyframes float {\n            0%, 100% { transform: translateY(0); }\n            50% { transform: translateY(-8px); }\n        }\n\n        @keyframes pulse-glow {\n            0%, 100% { opacity: 0.5; }\n            50% { opacity: 1; }\n        }\n\n        @keyframes spin-slow {\n            from { transform: rotate(0deg); }\n            to { transform: rotate(360deg); }\n        }\n\n        .animate-float {\n            animation: float 4s ease-in-out infinite;\n        }\n\n        .animate-pulse-glow {\n            animation: pulse-glow 2s ease-in-out infinite;\n        }\n\n        /* Status message */\n        .status-message {\n            min-height: 1.5rem;\n            font-weight: 600;\n            transition: all 0.3s ease;\n        }\n\n        /* Coin icon animation */\n        .coin-icon {\n            position: relative;\n        }\n\n        .coin-icon::after {\n            content: '';\n            position: absolute;\n            inset: -8px;\n            border-radius: 50%;\n            background: radial-gradient(circle, var(--glow-gold) 0%, transparent 70%);\n            opacity: 0;\n            transition: opacity 0.3s ease;\n        }\n\n        .coin-icon:hover::after {\n            opacity: 1;\n        }\n\n        /* Reduced motion */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n    </style>\n</head>\n<body class=\"no-scrollbar\">\n    <!-- Background layers -->\n    <div class=\"bg-layer bg-gradient-layer\"></div>\n    <div class=\"bg-layer bg-noise-layer\"></div>\n    <div class=\"bg-layer bg-grid-layer\"></div>\n    \n    <!-- Particles canvas -->\n    <canvas id=\"particles-canvas\"></canvas>\n\n    <!-- Top bar -->\n    <header class=\"top-bar-glass fixed top-0 w-full z-50 px-5 py-4\">\n        <div class=\"max-w-lg mx-auto flex justify-between items-center\">\n            <div class=\"flex items-center gap-3\">\n                <div class=\"w-11 h-11 rounded-xl bg-gradient-to-br from-amber-500/20 to-yellow-600/10 border border-amber-500/20 flex items-center justify-center\">\n                    <svg class=\"w-5 h-5 text-amber-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <circle cx=\"12\" cy=\"12\" r=\"8\"/>\n                        <path d=\"M12 8v8M9 12h6\"/>\n                    </svg>\n                </div>\n                <div>\n                    <p class=\"text-[0.6rem] text-slate-500 uppercase tracking-[0.15em] font-semibold\">Balance</p>\n                    <div class=\"flex items-baseline gap-1.5\">\n                        <span class=\"text-2xl font-bold font-display tracking-tight\" id=\"total-balance\">0</span>\n                        <span class=\"text-xs font-bold text-amber-400\">ETC</span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"w-11 h-11 rounded-full bg-gradient-to-br from-slate-700/50 to-slate-800/50 border border-white/10 flex items-center justify-center\">\n                <svg class=\"w-5 h-5 text-slate-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                    <circle cx=\"12\" cy=\"8\" r=\"4\"/>\n                    <path d=\"M4 20c0-4 4-6 8-6s8 2 8 6\"/>\n                </svg>\n            </div>\n        </div>\n    </header>\n\n    <!-- Pages -->\n    <main class=\"relative z-10\">\n        <!-- HOME PAGE -->\n        <section id=\"page-home\" class=\"page active pt-24 px-5\">\n            <div class=\"max-w-lg mx-auto space-y-5\">\n                <!-- Hero Card -->\n                <div class=\"glass-premium p-6 stagger-child relative\">\n                    <div class=\"accent-line accent-gold\"></div>\n                    <div class=\"flex items-center gap-4 mb-6\">\n                        <div class=\"w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-500/15 to-amber-600/5 border border-amber-500/20 flex items-center justify-center animate-float\">\n                            <svg class=\"w-8 h-8 text-amber-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">\n                                <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                            </svg>\n                        </div>\n                        <div>\n                            <h1 class=\"text-2xl font-bold font-display\">Baga Nagaan Dhufte</h1>\n                            <p class=\"text-sm text-slate-400\">Maallaqa sassaabbachuuf qophiidhaa</p>\n                        </div>\n                    </div>\n\n                    <div class=\"grid grid-cols-2 gap-3\">\n                        <div class=\"stat-card\">\n                            <div class=\"flex items-center gap-2 mb-2\">\n                                <svg class=\"w-4 h-4 text-teal-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                    <rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/>\n                                    <path d=\"M10 9l5 3-5 3V9z\"/>\n                                </svg>\n                                <span class=\"stat-label mb-0\">Ads Watched</span>\n                            </div>\n                            <p class=\"stat-value text-teal-400\" id=\"ads-count\">0</p>\n                        </div>\n                        <div class=\"stat-card\">\n                            <div class=\"flex items-center gap-2 mb-2\">\n                                <svg class=\"w-4 h-4 text-emerald-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                    <path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/>\n                                </svg>\n                                <span class=\"stat-label mb-0\">Bonus Rate</span>\n                            </div>\n                            <p class=\"stat-value text-emerald-400\">1.2x</p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Daily Quest -->\n                <div class=\"glass-premium p-5 stagger-child relative flex items-center gap-4\">\n                    <div class=\"accent-line accent-teal\"></div>\n                    <div class=\"progress-ring flex-shrink-0\">\n                        <svg width=\"56\" height=\"56\">\n                            <circle class=\"progress-ring-bg\" cx=\"28\" cy=\"28\" r=\"24\" fill=\"none\" stroke-width=\"4\"/>\n                            <circle class=\"progress-ring-fill\" cx=\"28\" cy=\"28\" r=\"24\" fill=\"none\" stroke-width=\"4\" stroke-dasharray=\"150.8\" stroke-dashoffset=\"135.72\" id=\"quest-progress\"/>\n                        </svg>\n                        <span class=\"progress-ring-text\" id=\"quest-count\">0/10</span>\n                    </div>\n                    <div class=\"flex-1\">\n                        <h3 class=\"font-bold font-display\">Daily Quest</h3>\n                        <p class=\"text-sm text-slate-400\">Watch 10 ads for bonus reward</p>\n                    </div>\n                    <div class=\"text-right\">\n                        <p class=\"text-xs text-slate-500\">Reward</p>\n                        <p class=\"font-bold text-amber-400\">+500</p>\n                    </div>\n                </div>\n\n                <!-- Stats Row -->\n                <div class=\"grid grid-cols-2 gap-3 stagger-child\">\n                    <div class=\"glass-premium p-4 relative\">\n                        <div class=\"accent-line accent-rose\"></div>\n                        <div class=\"flex items-center gap-3\">\n                            <svg class=\"w-5 h-5 text-rose-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83\"/>\n                            </svg>\n                            <div>\n                                <p class=\"text-xs text-slate-500\">Streak</p>\n                                <p class=\"font-bold text-rose-400\">7 Days</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"glass-premium p-4 relative\">\n                        <div class=\"accent-line accent-violet\"></div>\n                        <div class=\"flex items-center gap-3\">\n                            <svg class=\"w-5 h-5 text-violet-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M8 21h8M12 17v4M5 12a7 7 0 1114 0c0 3-2 5-4 6H9c-2-1-4-3-4-6z\"/>\n                            </svg>\n                            <div>\n                                <p class=\"text-xs text-slate-500\">Rank</p>\n                                <p class=\"font-bold text-violet-400\">Gold</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- WATCH PAGE -->\n        <section id=\"page-watch\" class=\"page pt-24 px-5\">\n            <div class=\"max-w-lg mx-auto\">\n                <h2 class=\"text-2xl font-bold font-display mb-6 stagger-child\">\n                    Video <span class=\"text-teal-400\">Rewards</span>\n                </h2>\n\n                <div class=\"glass-premium p-8 text-center stagger-child relative\">\n                    <div class=\"accent-line accent-teal\"></div>\n                    \n                    <!-- Video Icon Container -->\n                    <div class=\"w-28 h-28 mx-auto mb-6 relative\">\n                        <div class=\"absolute inset-0 rounded-full bg-gradient-to-br from-teal-500/20 to-cyan-500/10 animate-pulse-glow\"></div>\n                        <div class=\"absolute inset-2 rounded-full bg-gradient-to-br from-slate-800/80 to-slate-900/80 border border-teal-500/30 flex items-center justify-center\">\n                            <svg class=\"w-10 h-10 text-teal-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">\n                                <rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"3\"/>\n                                <path d=\"M10 9l5 3-5 3V9z\" fill=\"currentColor\"/>\n                            </svg>\n                        </div>\n                    </div>\n\n                    <h3 class=\"text-xl font-bold font-display mb-2\">Watch Ad</h3>\n                    <p class=\"text-slate-400 mb-6 text-sm\">Watch a short video and earn <span class=\"text-amber-400 font-bold\">100 Coins</span> instantly.</p>\n\n                    <button id=\"adBtn\" class=\"btn-primary w-full flex items-center justify-center gap-2\">\n                        <svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                            <path d=\"M8 5v14l11-7z\"/>\n                        </svg>\n                        <span>Start Video Ad</span>\n                    </button>\n\n                    <p id=\"status-msg\" class=\"status-message mt-4 text-sm\"></p>\n                </div>\n            </div>\n        </section>\n\n        <!-- INVITE PAGE -->\n        <section id=\"page-invite\" class=\"page pt-24 px-5\">\n            <div class=\"max-w-lg mx-auto\">\n                <h2 class=\"text-2xl font-bold font-display mb-6 stagger-child\">\n                    Referral <span class=\"text-emerald-400\">Program</span>\n                </h2>\n\n                <div class=\"glass-premium p-8 text-center stagger-child relative\">\n                    <div class=\"accent-line accent-emerald\"></div>\n                    \n                    <div class=\"w-20 h-20 mx-auto mb-6 rounded-full bg-gradient-to-br from-emerald-500/20 to-green-500/10 border border-emerald-500/30 flex items-center justify-center animate-float\">\n                        <svg class=\"w-10 h-10 text-emerald-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">\n                            <path d=\"M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2\"/>\n                            <circle cx=\"9\" cy=\"7\" r=\"4\"/>\n                            <path d=\"M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75\"/>\n                        </svg>\n                    </div>\n\n                    <h3 class=\"text-xl font-bold font-display mb-2\">Invite Friends</h3>\n                    <p class=\"text-slate-300 mb-8\">Hiriyaa kee affeeri, tokkoon tokkoo isaanitiif <span class=\"text-emerald-400 font-bold text-lg\">500 Coins</span> fudhu.</p>\n\n                    <div class=\"space-y-3\">\n                        <button id=\"copy-btn\" class=\"btn-secondary w-full flex items-center justify-center gap-2\">\n                            <svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\"/>\n                                <path d=\"M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1\"/>\n                            </svg>\n                            <span>Copy Invite Link</span>\n                        </button>\n                        <button id=\"share-btn\" class=\"btn-share w-full flex items-center justify-center gap-2\">\n                            <svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z\"/>\n                            </svg>\n                            <span>Share on Telegram</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- WALLET PAGE -->\n        <section id=\"page-wallet\" class=\"page pt-24 px-5\">\n            <div class=\"max-w-lg mx-auto\">\n                <h2 class=\"text-2xl font-bold font-display mb-6 stagger-child\">\n                    My <span class=\"text-rose-400\">Wallet</span>\n                </h2>\n\n                <div class=\"glass-premium p-6 space-y-6 stagger-child relative\">\n                    <div class=\"accent-line accent-rose\"></div>\n                    \n                    <div>\n                        <label class=\"stat-label block mb-2\">TON Wallet Address</label>\n                        <input type=\"text\" id=\"wallet-input\" placeholder=\"UQ... or Wallet ID\" class=\"input-premium\">\n                    </div>\n\n                    <div class=\"p-5 rounded-xl bg-gradient-to-r from-rose-500/10 to-pink-500/5 border border-rose-500/20\">\n                        <div class=\"flex items-center gap-2 mb-1\">\n                            <svg class=\"w-4 h-4 text-rose-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                                <path d=\"M12 6v6l4 2\"/>\n                            </svg>\n                            <span class=\"text-xs text-rose-400 font-semibold uppercase tracking-wider\">Minimum Payout</span>\n                        </div>\n                        <p class=\"text-2xl font-bold font-display\">10,000 Coins</p>\n                        <p class=\"text-sm text-slate-500\">≈ $10.00</p>\n                    </div>\n\n                    <button id=\"withdraw-btn\" class=\"btn-locked w-full flex items-center justify-center gap-2\">\n                        <svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\"/>\n                            <path d=\"M7 11V7a5 5 0 0110 0v4\"/>\n                        </svg>\n                        <span>Withdraw Locked</span>\n                    </button>\n\n                    <p class=\"text-center text-xs text-slate-600\">Withdrawals open soon</p>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    <!-- Bottom Navigation -->\n    <nav class=\"nav-glass fixed bottom-0 w-full z-50 px-4 py-3\">\n        <div class=\"max-w-lg mx-auto flex justify-around items-center\">\n            <button class=\"nav-item active\" data-page=\"home\">\n                <svg class=\"nav-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                    <path d=\"M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z\"/>\n                    <polyline points=\"9,22 9,12 15,12 15,22\"/>\n                </svg>\n                <span class=\"nav-label\">Home</span>\n            </button>\n            <button class=\"nav-item\" data-page=\"watch\">\n                <svg class=\"nav-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                    <rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/>\n                    <path d=\"M10 9l5 3-5 3V9z\"/>\n                </svg>\n                <span class=\"nav-label\">Ads</span>\n            </button>\n            <button class=\"nav-item\" data-page=\"invite\">\n                <svg class=\"nav-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                    <path d=\"M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2\"/>\n                    <circle cx=\"9\" cy=\"7\" r=\"4\"/>\n                    <path d=\"M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75\"/>\n                </svg>\n                <span class=\"nav-label\">Invite</span>\n            </button>\n            <button class=\"nav-item\" data-page=\"wallet\">\n                <svg class=\"nav-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                    <path d=\"M21 4H3a2 2 0 00-2 2v12a2 2 0 002 2h18a2 2 0 002-2V6a2 2 0 00-2-2z\"/>\n                    <path d=\"M1 10h22\"/>\n                </svg>\n                <span class=\"nav-label\">Wallet</span>\n            </button>\n        </div>\n    </nav>\n\n    <script>\n        // Initialize variables first\n        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n        let coins = parseFloat(localStorage.getItem('user_coins')) || 0;\n        let adCount = parseInt(localStorage.getItem('ad_count')) || 0;\n        let particles = [];\n        let animationId = null;\n\n        // Telegram WebApp\n        const tg = window.Telegram?.WebApp;\n        if (tg) {\n            tg.ready();\n            tg.expand();\n            tg.setHeaderColor('#05080d');\n            tg.setBackgroundColor('#05080d');\n        }\n\n        // DOM Elements\n        const totalBalanceEl = document.getElementById('total-balance');\n        const adsCountEl = document.getElementById('ads-count');\n        const questProgressEl = document.getElementById('quest-progress');\n        const questCountEl = document.getElementById('quest-count');\n        const adBtn = document.getElementById('adBtn');\n        const statusMsg = document.getElementById('status-msg');\n        const copyBtn = document.getElementById('copy-btn');\n        const shareBtn = document.getElementById('share-btn');\n        const withdrawBtn = document.getElementById('withdraw-btn');\n        const navItems = document.querySelectorAll('.nav-item');\n\n        // Update display\n        function updateDisplay() {\n            if (totalBalanceEl) {\n                totalBalanceEl.textContent = coins.toLocaleString();\n            }\n            if (adsCountEl) {\n                adsCountEl.textContent = adCount;\n            }\n            \n            // Update quest progress\n            const questGoal = 10;\n            const progress = Math.min(adCount, questGoal);\n            const circumference = 150.8;\n            const offset = circumference - (progress / questGoal) * circumference;\n            \n            if (questProgressEl) {\n                questProgressEl.setAttribute('stroke-dashoffset', Math.max(0, offset).toString());\n            }\n            if (questCountEl) {\n                questCountEl.textContent = `${progress}/${questGoal}`;\n            }\n            \n            localStorage.setItem('user_coins', coins.toString());\n            localStorage.setItem('ad_count', adCount.toString());\n        }\n\n        // Page navigation\n        function showPage(pageId) {\n            const pages = document.querySelectorAll('.page');\n            pages.forEach(page => page.classList.remove('active'));\n            \n            const targetPage = document.getElementById(`page-${pageId}`);\n            if (targetPage) {\n                targetPage.classList.add('active');\n            }\n\n            navItems.forEach(item => {\n                item.classList.remove('active');\n                if (item.getAttribute('data-page') === pageId) {\n                    item.classList.add('active');\n                }\n            });\n\n            if (tg && tg.HapticFeedback) {\n                tg.HapticFeedback.impactOccurred('light');\n            }\n        }\n\n        // Nav item click handlers\n        navItems.forEach(item => {\n            item.addEventListener('click', () => {\n                const pageId = item.getAttribute('data-page');\n                if (pageId) {\n                    showPage(pageId);\n                }\n            });\n        });\n\n        // Adsgram\n        const AdController = window.Adsgram ? window.Adsgram.init({ blockId: \"24893\", debug: false }) : null;\n\n        async function watchAd() {\n            if (!AdController) {\n                if (statusMsg) {\n                    statusMsg.textContent = \"Ad service unavailable\";\n                    statusMsg.style.color = \"#fb7185\";\n                }\n                return;\n            }\n\n            if (adBtn) {\n                adBtn.disabled = true;\n                adBtn.style.opacity = \"0.6\";\n            }\n            if (statusMsg) {\n                statusMsg.textContent = \"Loading ad...\";\n                statusMsg.style.color = \"#22d3ee\";\n            }\n\n            try {\n                const result = await AdController.show();\n                if (result && result.done) {\n                    coins += 100;\n                    adCount += 1;\n                    updateDisplay();\n                    if (statusMsg) {\n                        statusMsg.textContent = \"Success! +100 Coins\";\n                        statusMsg.style.color = \"#34d399\";\n                    }\n                    if (tg && tg.HapticFeedback) {\n                        tg.HapticFeedback.notificationOccurred('success');\n                    }\n                } else {\n                    if (statusMsg) {\n                        statusMsg.textContent = \"Ad not completed\";\n                        statusMsg.style.color = \"#fb7185\";\n                    }\n                }\n            } catch (e) {\n                if (statusMsg) {\n                    statusMsg.textContent = \"Ad temporarily unavailable\";\n                    statusMsg.style.color = \"#fb7185\";\n                }\n            } finally {\n                setTimeout(() => {\n                    if (adBtn) {\n                        adBtn.disabled = false;\n                        adBtn.style.opacity = \"1\";\n                    }\n                    if (statusMsg) {\n                        statusMsg.textContent = \"\";\n                    }\n                }, 3000);\n            }\n        }\n\n        if (adBtn) {\n            adBtn.addEventListener('click', watchAd);\n        }\n\n        // Copy invite link\n        if (copyBtn) {\n            copyBtn.addEventListener('click', () => {\n                navigator.clipboard.writeText(\"https://t.me/Ethio_Coin1_bot\").then(() => {\n                    const originalText = copyBtn.innerHTML;\n                    copyBtn.innerHTML = `\n                        <svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <polyline points=\"20,6 9,17 4,12\"/>\n                        </svg>\n                        <span>Copied!</span>\n                    `;\n                    copyBtn.style.borderColor = \"#34d399\";\n                    copyBtn.style.color = \"#34d399\";\n                    \n                    if (tg && tg.HapticFeedback) {\n                        tg.HapticFeedback.notificationOccurred('success');\n                    }\n                    \n                    setTimeout(() => {\n                        copyBtn.innerHTML = originalText;\n                        copyBtn.style.borderColor = \"\";\n                        copyBtn.style.color = \"\";\n                    }, 2000);\n                });\n            });\n        }\n\n        // Share on Telegram\n        if (shareBtn) {\n            shareBtn.addEventListener('click', () => {\n                const url = \"https://t.me/share/url?url=https://t.me/Ethio_Coin1_bot&text=Kootu maallaqa waliin hojjennu!\";\n                if (tg) {\n                    tg.openTelegramLink(url);\n                } else {\n                    window.open(url, '_blank');\n                }\n            });\n        }\n\n        // Withdraw button\n        if (withdrawBtn) {\n            withdrawBtn.addEventListener('click', () => {\n                if (coins >= 10000) {\n                    alert('Withdrawal request submitted!');\n                } else {\n                    alert(`Kaffaltiin kan jalqabu yoo 10,000 geessaniidha! Har'a ${coins.toLocaleString()} qabda.`);\n                }\n            });\n        }\n\n        // Particle system\n        function initParticles() {\n            const canvas = document.getElementById('particles-canvas');\n            if (!canvas || prefersReducedMotion) return;\n\n            const ctx = canvas.getContext('2d');\n            if (!ctx) return;\n\n            function resize() {\n                canvas.width = window.innerWidth;\n                canvas.height = window.innerHeight;\n            }\n            resize();\n            window.addEventListener('resize', resize);\n\n            const particleCount = 40;\n            \n            for (let i = 0; i < particleCount; i++) {\n                particles.push({\n                    x: Math.random() * canvas.width,\n                    y: Math.random() * canvas.height,\n                    radius: Math.max(0.5, Math.random() * 2),\n                    vx: (Math.random() - 0.5) * 0.3,\n                    vy: (Math.random() - 0.5) * 0.3,\n                    opacity: Math.random() * 0.4 + 0.1\n                });\n            }\n\n            function animate() {\n                if (!ctx) return;\n                ctx.clearRect(0, 0, canvas.width, canvas.height);\n\n                particles.forEach(p => {\n                    p.x += p.vx;\n                    p.y += p.vy;\n\n                    if (p.x < 0) p.x = canvas.width;\n                    if (p.x > canvas.width) p.x = 0;\n                    if (p.y < 0) p.y = canvas.height;\n                    if (p.y > canvas.height) p.y = 0;\n\n                    ctx.beginPath();\n                    const radius = Math.max(0.1, p.radius);\n                    ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);\n                    const opacity = Math.max(0, Math.min(1, p.opacity));\n                    ctx.fillStyle = `rgba(229, 177, 46, ${opacity})`;\n                    ctx.fill();\n                });\n\n                animationId = requestAnimationFrame(animate);\n            }\n\n            animate();\n        }\n\n        // Initialize\n        updateDisplay();\n        initParticles();\n    </script>\n</body>\n</html>"
}
